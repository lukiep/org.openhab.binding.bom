# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicit LF enforcement for key source and config files
*.java       text eol=lf charset=utf-8
*.xml        text eol=lf charset=utf-8
*.pom        text eol=lf charset=utf-8
*.json       text eol=lf charset=utf-8
*.yaml       text eol=lf charset=utf-8
*.yml        text eol=lf charset=utf-8
*.properties text eol=lf charset=utf-8
*.md         text eol=lf
*.txt        text eol=lf

# Scripts and tooling
*.sh         text eol=lf
*.bash       text eol=lf
*.bat        text eol=lf
*.ps1        text eol=lf

# Spotless and formatting configs
*.gitattributes text eol=lf
*.editorconfig  text eol=lf
*.spotless*     text eol=lf

.project     text eol=lf charset=utf-8
.classpath   text eol=lf charset=utf-8
*.target     text eol=lf charset=utf-8
*.setup      text eol=lf charset=utf-8


# License headers and templates
LICENSE*     text eol=lf
NOTICE*      text eol=lf

# Prevent normalization of binary files
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.jar        binary
*.class      binary
*.pdf        binary
*.exe        binary
*.dll        binary

# Optional: enforce LF for build scripts and CI configs
*.gradle     text eol=lf
*.groovy     text eol=lf
*.jenkins*   text eol=lf
*.ci         text eol=lf
*.workflow   text eol=lf

# Optional: enforce LF for HTML, CSS, JS
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf